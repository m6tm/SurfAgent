{
  "manifest_version": 3,
  "name": "SurfAgent",
  "short_name": "SurfAgent",
  "description": "Agent de navigation web autonome, integrable par d'autres outils et applications. Connexion via ton compte ChatGPT.",
  "version": "0.1.0",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "SurfAgent"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["alarms", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://auth.openai.com/*",
    "https://chatgpt.com/backend-api/*",
    "https://www.upwork.com/*",
    "<all_urls>"
  ]
}